{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:pcm:0.1:schema:schema-document",
  "title": "PCM 0.1 schema document",
  "description": "The typed fields of an intent, the claim types it needs and whether it needs a grant. Its name on the wire is name@sha256:<hex of SHA-256 of its JCS>. Beyond this schema a verifier also rejects an int field whose min is above its max, and an id field whose pattern does not compile. Every pattern matches the whole value, with ASCII classes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pcm_schema",
    "name",
    "fields"
  ],
  "properties": {
    "pcm_schema": {
      "type": "integer",
      "const": 0
    },
    "name": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[a-z][a-z0-9_.-]*(?![\\s\\S])"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "max"
            ],
            "properties": {
              "type": {
                "const": "string"
              },
              "max": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65536
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "min",
              "max"
            ],
            "properties": {
              "type": {
                "const": "int"
              },
              "min": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "max": {
                "type": "integer",
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "currency",
              "max"
            ],
            "properties": {
              "type": {
                "const": "money"
              },
              "currency": {
                "type": "string",
                "maxLength": 3,
                "pattern": "^[A-Z]{3}(?![\\s\\S])"
              },
              "max": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "pattern"
            ],
            "properties": {
              "type": {
                "const": "id"
              },
              "pattern": {
                "type": "string",
                "maxLength": 256,
                "minLength": 1
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "values"
            ],
            "properties": {
              "type": {
                "const": "enum"
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "maxItems": 256,
                "items": {
                  "type": "string"
                },
                "uniqueItems": true
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "bool"
              },
              "optional": {
                "type": "boolean"
              }
            }
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "const": "time"
              },
              "optional": {
                "type": "boolean"
              }
            }
          }
        ]
      },
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9_]{0,63}(?![\\s\\S])"
      }
    },
    "claims": {
      "type": "array",
      "maxItems": 4,
      "items": {
        "enum": [
          "tests_passed",
          "approved_by",
          "reached_host",
          "file_written"
        ]
      },
      "uniqueItems": true
    },
    "grant": {
      "type": "boolean"
    }
  }
}
